<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sqlcli</AssemblyName>
    <RootNamespace>SqlCli</RootNamespace>

    <!-- Global dotnet tool olarak yüklenebilir -->
    <!-- dotnet pack && dotnet tool install -g -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sqlcli</ToolCommandName>
    <PackageId>SqlCli</PackageId>
    <Version>2.3.0</Version>
    <Description>Çok-sağlayıcı (SQL Server + PostgreSQL) yönetim + keşif + migration CLI. Multi-profile connection, describe/search/relationships, query history, performance diagnostics, cross-provider export/import/diff. Oracle için dialect seam hazır. v2.2: assert (koşulabilir veri denetimi, exit 1), lookup (kod tablosu → YAML/JSON), --read-only muhafızı, adlı parametre, zaman aşımı + geçici hata retry, bağlantı string'inde ${ENV} genişletmesi. v2.3: sürüm muhafızı (eski kopya çalışırsa hata + güncelle). Spectre.Console UX + Cocona CLI framework.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cocona" Version="2.2.0" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <PackageReference Include="Npgsql" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Spectre.Console.Json" Version="0.49.1" />
  </ItemGroup>

</Project>
